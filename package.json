{
  "name": "cursor-pinned-projects",
  "displayName": "Pinned Projects",
  "description": "Pin selected workspace projects to the top of the File Explorer sidebar",
  "version": "0.1.7",
  "publisher": "cursor-pinned-projects",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cursorPinnedProjects.pinToTop",
        "title": "Pin Project to Top"
      },
      {
        "command": "cursorPinnedProjects.unpin",
        "title": "Unpin Project"
      },
      {
        "command": "cursorPinnedProjects.applyOrder",
        "title": "Apply Pinned Order"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "cursorPinnedProjects.pinToTop",
          "when": "explorerResourceIsRoot",
          "group": "1_pinned@1"
        },
        {
          "command": "cursorPinnedProjects.unpin",
          "when": "explorerResourceIsRoot",
          "group": "1_pinned@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "typescript": "^5.3.0",
    "eslint": "^8.56.0"
  }
}
